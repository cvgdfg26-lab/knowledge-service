FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
WORKDIR /app
COPY services/requirements-gpu.txt ./
RUN pip install --no-cache-dir -r requirements-gpu.txt
COPY services/gpu_service.py ./
RUN useradd -u 10001 -M inference
USER 10001
CMD ["uvicorn", "gpu_service:app", "--host", "0.0.0.0", "--port", "8080"]
