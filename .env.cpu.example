# Copy to .env.cpu or generate random secrets with scripts/setup_local.py.
APP_ENV=dev
COOKIE_SECURE=false
CPU_BIND_IP=127.0.0.1
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:8001","http://localhost:8000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
MONGO_ROOT_USER=kb-root
MONGO_ROOT_PASSWORD=
MONGO_IMPORT_PASSWORD=
MONGO_QUERY_PASSWORD=
MONGO_WORKER_PASSWORD=
MINIO_ROOT_USER=kb-storage-root
MINIO_ROOT_PASSWORD=
MINIO_APP_USER=kb-business
MINIO_APP_PASSWORD=
MINIO_QUERY_USER=kb-query
MINIO_QUERY_PASSWORD=
MINIO_MILVUS_USER=milvus-storage
MINIO_MILVUS_PASSWORD=
NEO4J_PASSWORD=
MILVUS_ROOT_PASSWORD=
MILVUS_IMPORT_PASSWORD=
MILVUS_QUERY_PASSWORD=
MILVUS_WORKER_PASSWORD=
# Remote CPU host uses the GPU private IP/DNS, never Compose service names from another host.
BGE_M3_SERVICE_URL=
BGE_MODEL_REVISION=
BGE_SERVICE_TOKEN=
RERANKER_SERVICE_URL=
RERANKER_SERVICE_TOKEN=
RERANKER_MODEL_REVISION=
LLM_API_KEY=
MINERU_API_TOKEN=
# Exact hosts from your authorized MinerU upload/result URLs. Empty denies transfers.
MINERU_TRANSFER_HOSTS=[]
SEED_ADMIN_PASSWORD=
SEED_MAINTAINER_PASSWORD=
SEED_REVIEWER_PASSWORD=
SEED_READER_PASSWORD=
SEED_OUTSIDER_PASSWORD=
